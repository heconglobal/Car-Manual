+ const emit=poly=>{for(let j=1;j<poly.length-1;j++){const p=poly[0],q=poly[j],r=poly[j+1];if(Math.abs((q[0]-p[0])*(r[1]-p[1])-(q[1]-p[1])*(r[0]-p[0]))<1e-12)continue;for(const v of [p,q,r])out.push(...face(v[0],v[1]));}};
